---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import t from "../../i18n/en";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
---
<Base title={`${entry.data.title} | Álvaro Paiva`} description={entry.data.summary}>
  <article class="wrap post">
    <a class="arrow-link back" href={`${base}#work`}>← {t.work.back}</a>
    <p class="label">{entry.data.company} · {entry.data.year} · {entry.data.tag}</p>
    <h1 class="display">{entry.data.title}</h1>
    <p class="lead">{entry.data.summary}</p>
    <div class="metric display">{entry.data.metric}</div>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  .post { max-width: 820px; padding-top: 48px; padding-bottom: 96px; }
  .back { display: inline-block; margin-bottom: 40px; }
  h1 { font-size: clamp(48px, 8vw, 96px); margin: 12px 0 20px; }
  .lead { font-size: 20px; color: var(--ink-soft); margin: 0 0 32px; }
  .metric { background: var(--accent); color: var(--accent-ink); padding: 24px 28px; font-size: clamp(32px, 5vw, 56px); margin-bottom: 48px; }
  .body :global(h2) { font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); margin: 40px 0 12px; }
  .body :global(li + li) { margin-top: 8px; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 15px; }
  .body :global(th), .body :global(td) { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .body :global(th) { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); border-bottom-color: var(--ink); }
  .body :global(tr:last-child td) { border-bottom: 0; background: var(--bg-alt); }
  .body :global(code) { font-size: .88em; background: var(--bg-alt); padding: 1px 6px; }
  .body :global(blockquote) { margin: 24px 0; padding: 16px 20px; border-left: 3px solid var(--accent); background: var(--bg-alt); }
  .body :global(blockquote p) { margin: 0; }
  /* Diagrams: scroll sideways on phones instead of shrinking text to nothing */
  .body :global(.figure) { margin: 24px 0; }
  .body :global(.figure-scroll) { overflow-x: auto; border: 1px solid var(--line); background: #fff; }
  .body :global(.diagram) { display: block; width: 100%; min-width: 680px; height: auto; }
  .body :global(.diagram text) { font-family: var(--font-body); fill: var(--ink); }
  .body :global(.diagram .lane) { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; fill: var(--accent); }
  .body :global(.diagram .title) { font-size: 13px; font-weight: 600; }
  .body :global(.diagram .sub), .body :global(.diagram .edge) { font-size: 11.5px; fill: var(--ink-soft); }
  .body :global(.diagram .accent) { fill: var(--accent); }
  .body :global(figcaption) { font-size: 14px; color: var(--ink-soft); margin-top: 8px; }
  /* Numbered timeline with a "where it runs" chip per step */
  .body :global(ol.steps) { list-style: none; counter-reset: s; margin: 24px 0 0 14px; padding: 0; border-left: 2px solid var(--line); }
  .body :global(ol.steps li) { position: relative; counter-increment: s; padding: 0 0 20px 28px; margin: 0; }
  .body :global(ol.steps li::before) { content: counter(s); position: absolute; left: -15px; top: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); color: var(--accent); font: 700 13px/24px var(--font-body); text-align: center; }
  .body :global(.where) { display: inline-block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 2px 6px; margin-right: 8px; vertical-align: 2px; }
  .body :global(.w-gl) { background: var(--bg-alt); color: var(--ink-soft); }
  .body :global(.w-dp) { background: #fdf1d6; color: #8a5a00; }
  .body :global(.w-job) { background: #e3e7fd; color: var(--accent); }
  .body :global(.w-ai) { background: #e2f4e9; color: #1f7a46; }
  /* Mock of the verdict comment as it appears on a merge request */
  .body :global(.mr-note) { border: 1px solid var(--line); background: #fff; margin: 16px 0 24px; font-size: 15px; }
  .body :global(.mr-head) { display: flex; gap: 10px; align-items: center; padding: 10px 14px; background: var(--bg-alt); border-bottom: 1px solid var(--line); color: var(--ink-soft); font-size: 14px; }
  .body :global(.avatar) { width: 22px; height: 22px; border-radius: 50%; background: var(--accent); flex: none; }
  .body :global(.mr-body) { padding: 4px 16px 12px; }
  .body :global(.mr-body p) { margin: 10px 0; }
  .body :global(.mr-sentinel) { font-family: ui-monospace, monospace; font-size: 12px; color: var(--ink-soft); border-top: 1px dashed var(--line); padding-top: 8px; }
</style>
