---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import t from "../i18n/en";
import { resume, portfolio, languages, validationNumber } from "../lib/data";

const base = import.meta.env.BASE_URL;
const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const linkedin = resume.contact.links.find((l) => l.label.toLowerCase() === "linkedin")?.url;
const github = resume.contact.links.find((l) => l.url.includes("github.com"))?.url;
// Hero icon buttons (SVG paths from Simple Icons)
const socials = [
  { href: github, label: t.contact.github, icon: "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3" },
  { href: linkedin, label: t.contact.linkedin, icon: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" },
].filter((s) => s.href);
// Only in the contact section, not the hero
const writing = [
  { href: "https://alvarofpp.medium.com/", label: t.contact.medium },
  { href: "https://dev.to/alvarofpp", label: t.contact.devto },
];
const pad = (n: number) => String(n).padStart(2, "0");
// Resume bullet → case study that expands it (matched by the post's `highlights` prefixes)
const caseStudyFor = (bullet: string) =>
  work.find((w) => w.data.highlights.some((h) => bullet.startsWith(h)));
---
<Base>
  <!-- Hero -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label">{t.hero.eyebrow}</p>
      <h1 class="display name">{t.hero.firstName}<br />{t.hero.lastName}</h1>
      <p class="arc">
        {t.hero.arc.map((step, i) => (
          <>{i > 0 && <span class="arc-sep">→</span>}<span class:list={{ now: i === t.hero.arc.length - 1 }}>{step}</span></>
        ))}
      </p>
      <p class="tagline">{t.hero.tagline}</p>
      <div class="hero-actions">
        <a class="btn" href="#work">{t.hero.cta} <span aria-hidden="true">→</span></a>
        {socials.map((s) => (
          <a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={s.icon} /></svg>
          </a>
        ))}
      </div>
      <p class="label loc">{t.hero.location}</p>
    </div>
    <div class="hero-photo">
      <div class="photo-frame">
        <img src={`${base}alvarofpp.jpg`} alt={resume.name} width="1020" height="1000" />
      </div>
      <span class="slash" aria-hidden="true"></span>
      <span class="dot" aria-hidden="true"></span>
    </div>
  </section>

  <!-- Areas strip -->
  <div class="strip">
    <div class="wrap strip-inner label">
      <span class="dot-sm" aria-hidden="true"></span>
      {t.areas.map((a) => <span>{a}</span>)}
      <span class="dot-sm" aria-hidden="true"></span>
    </div>
  </div>

  <!-- Stats -->
  <section class="wrap stats">
    {t.stats.map((s) => (
      <div class="stat">
        <span class="display stat-value">{s.value}</span>
        <span class="label">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- Selected work -->
  <section id="work" class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="display">{t.work.title}</h2></div>
      <div class="work-grid">
        {work.map((w, i) => (
          <a class="work-card" href={`${base}work/${w.id}/`}>
            <div class:list={["cover", `cover-${i % 3}`]}>
              <span class="label cover-tag">{pad(i + 1)} · {w.data.tag}</span>
              <span class="display cover-metric">{w.data.metric}</span>
            </div>
            <div class="work-meta">
              <div>
                <h3>{w.data.title}</h3>
                <p class="label">{w.data.company} · {w.data.year}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
            <p class="work-summary">{w.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="display">{t.experience.title}</h2></div>
      <ol class="xp">
        {resume.experience.map((x, i) => (
          <li class="xp-item">
            <span class="display xp-num">{pad(i + 1)}</span>
            <div class="xp-head">
              <h3>{x.position}</h3>
              <p class="xp-company">{x.company}</p>
              <p class="label">{x.dates} · {x.location}</p>
            </div>
            <ul class="xp-highlights">
              {x.highlights.map((h) => {
                const post = caseStudyFor(h);
                return (
                  <li class:list={{ linked: post }}>
                    {h}
                    {post && <a class="case-link" href={`${base}work/${post.id}/`}>{t.work.readMore} →</a>}
                  </li>
                );
              })}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Education -->
  <section id="education" class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="display">{t.education.title}</h2></div>
      <div class="edu">
        <ol class="xp edu-list">
          {resume.education.map((e) => (
            <li class="edu-item">
              <h3>{e.qualification}</h3>
              <p class="xp-company">{e.institution}</p>
              <p class="label">{e.dates} · {e.location}</p>
              {e.highlights && <ul class="xp-highlights">{e.highlights.map((h) => <li>{h}</li>)}</ul>}
            </li>
          ))}
        </ol>
        <div class="edu-side">
          <p class="label">{t.education.certifications}</p>
          <ul class="certs">
            {resume.certifications.map((c) => {
              const code = validationNumber(c.details);
              return (
                <li>
                  <strong>{c.name}</strong>
                  <span class="label">{c.dates}</span>
                  {code && <span class="cert-code">{t.education.validation} <code>{code}</code></span>}
                  {c.url && <a class="case-link" href={c.url} target="_blank" rel="noopener">{t.education.verify} ↗</a>}
                </li>
              );
            })}
          </ul>
          <p class="label">{t.education.languages}</p>
          <ul class="langs">
            {languages.map((l) => (
              <li>{l.flag ? <img class="flag" src={`${base}flags/${l.flag}.svg`} alt="" width="24" height="17" /> : <span />}<span>{l.name}</span><span class="label">{l.level}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Toolkit -->
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="display">{t.skills.title}</h2></div>
      <div class="skills">
        {resume.skills.map((s) => (
          <div class="skill-row">
            <p class="label">{s.level}</p>
            <ul class="chips">
              {s.items.replace(/\.$/, "").split(",").map((i) => <li>{i.trim()}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section id="projects" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">{t.projects.title}</h2>
        {github && <a class="arrow-link" href={github}>{t.contact.github} →</a>}
      </div>
      <div class="oss-grid">
        {portfolio.projects.map((p) => (
          <a class="oss" href={`https://github.com/${p.repo}`}>
            <p class="label">{p.type}</p>
            <h3>{p.repo}</h3>
            <p>{p.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Hire through partners -->
  <section id="hire" class="section">
    <div class="wrap">
      <div class="section-head"><h2 class="display">{t.hire.title}</h2></div>
      <p class="hire-sub">{t.hire.subtitle}</p>
      <div class="hire-grid">
        <a class="partner" href="https://zazmic.com/" target="_blank" rel="noopener">
          <img src={`${base}partners/zazmic.svg`} alt={t.hire.zazmic} width="162" height="35" />
        </a>
        <!-- Toptal badge: their markup, with classes renamed so the styles stay scoped -->
        <div class="tt-hex">
          <div class="tt-inner">
            <svg width="64" viewBox="0 0 60 17" aria-hidden="true"><path d="m20.85 6.38 6.06-.89 2.72-5.49 2.71 5.49 6.06.89-4.39 4.28 1.04 6.03-5.42-2.85-5.43 2.85 1.04-6.03zm33.06 7.17 1.85-.27.82-1.67.83 1.67 1.84.27-1.33 1.31.31 1.83-1.65-.87-1.66.87.32-1.83zm-3.38-3.01-3.61-.52-1.61-3.26-1.62 3.26-3.6.52 2.6 2.55-.61 3.59 3.23-1.69 3.21 1.69-.61-3.59zm-45.19 3.01-1.85-.27-.82-1.67-.83 1.67-1.84.27 1.33 1.31-.31 1.83 1.65-.87 1.65.87-.31-1.83zm3.38-3.01 3.61-.52 1.61-3.26 1.61 3.26 3.61.52-2.6 2.55.61 3.59-3.23-1.69-3.22 1.69.62-3.59z" fill="#fff"/></svg>
            <h3 class="tt-title">{t.hire.toptal.talent}</h3>
            <div class="tt-rule"></div>
            <span class="tt-vetted">{t.hire.toptal.vetted}</span>
            <svg viewBox="0 0 108 30" width="100" role="img" aria-label={t.hire.toptal.label}><g clip-rule="evenodd" fill="#fff" fill-rule="evenodd"><path d="m8.11 0 6.71 6.7c.05.05.09.1.15.15l5.85 5.85-9.51 9.46 4.35 4.36-2.91 2.89-6.66-6.66c-.08-.07-.16-.15-.24-.23l-5.85-5.84 9.48-9.43-4.32-4.31zm4.25 10.5c-.09-.02-.18-.02-.26 0-.09.03-.16.07-.32.22l-5.41 5.39c-.16.16-.2.23-.22.31-.03.09-.03.18 0 .26.02.09.07.17.22.32l1.72 1.72c.15.15.22.19.31.22.09.02.17.02.26 0 .09-.03.16-.07.31-.22l5.41-5.39c.16-.15.2-.23.23-.31.02-.09.02-.17 0-.26s-.07-.16-.22-.31l-1.72-1.72c-.15-.16-.23-.2-.31-.23z"/><path d="m62.65 7.76c2.11 0 3.91.82 5.34 2.4 1.46 1.53 2.19 3.64 2.18 6.26 0 2.56-.75 4.8-2.24 6.38-1.47 1.57-3.34 2.37-5.58 2.37-1.93-.01-3.68-.7-4.84-1.89l-.16-.17-.01 6.75-3.82-.01v-.28l.04-21.61h3.8l-.01 2.64c1.25-1.41 3.26-2.84 5.3-2.84zm24.45.06c2.18 0 3.68.49 4.84 1.44 1.11.92 1.7 2.56 1.75 4.29v.26l-.02 11.14h-3.87v-.46c0-.48 0-.97 0-1.47-1.12 1.55-2.68 2.3-4.76 2.3-1.65 0-3.05-.5-4.07-1.43-1.03-.94-1.58-2.23-1.58-3.73.02-2.83 2.02-4.79 5.52-5.4l.27-.05 4.64-.73v-.37c0-.78-.23-1.72-.69-2.11-.47-.4-1.04-.73-2.03-.73-2.73 0-3.29 2.01-3.32 3.02v.09l-3.42.04c0-1.49.69-3.42 2.08-4.63 1.12-.97 2.75-1.42 4.33-1.47h.3zm-14.98-4.36h3.81l-.01 4.56h3.53v3.18l-3.54-.01-.01 8.54c0 .94.19 1.56.6 1.85.43.3 1.3.02 1.3.02l.34 3.32s-1.2.31-1.96.31c-.99 0-1.84-.25-2.49-.75-1.06-.8-1.6-2.2-1.6-4.17l.02-9.12-3.19-3.19 3.2.01zm-22.46 6.8c1.1 1.13 2.41 3.14 2.4 6.26-.01 3.11-1.32 5.11-2.41 6.24-1.5 1.54-3.54 2.42-5.59 2.42-.08 0-.16 0-.25-.01-2.19-.01-4.13-.79-5.75-2.33-1.63-1.55-2.46-3.68-2.46-6.36s.84-4.82 2.47-6.36c1.62-1.53 3.55-2.3 5.75-2.3 2.17-.07 4.29.83 5.84 2.44zm-8.81-7.04v3.77l-7.36.01.02 17.97-3.97-.01v-.34l.03-17.63h-7.51l.01-3.77zm54.68.25 3.42.01v.09l-.03 21.38-3.42-.01v-.1zm-5.71 13.58-3.81.64c-1.86.32-2.72 1.04-2.73 2.3-.01 1.15.81 1.92 2.09 1.99h.16.02c2.44 0 4.17-1.9 4.26-4.67l.01-.22zm-46.02-5.84c-1.28 0-2.39.49-3.29 1.47-.88.96-1.33 2.24-1.33 3.81 0 1.58.45 2.86 1.33 3.82.89.98 2 1.47 3.28 1.48 1.3 0 2.42-.49 3.31-1.47.9-.98 1.35-2.26 1.36-3.81.01-1.56-.45-2.84-1.35-3.82s-2.01-1.48-3.31-1.48zm17.94.12h-.02c-1.28 0-2.34.46-3.24 1.43-.9.94-1.35 2.16-1.36 3.63 0 1.49.45 2.83 1.35 3.8.92.95 1.98 1.42 3.25 1.42 1.29 0 2.38-.48 3.25-1.41.91-.97 1.35-2.3 1.36-3.79 0-1.48-.46-2.7-1.34-3.63-.87-.96-1.96-1.45-3.25-1.45z"/></g></svg>
            <a class="tt-cta" href="https://www.toptal.com/developers/resume/alvaro-ferreira-pires-de-paiva#qaxPbd" target="_blank" rel="noopener">{t.hire.toptal.cta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="cta">
    <div class="wrap cta-inner">
      <h2 class="cta-title">{t.contact.title}</h2>
      <div class="cta-right">
        <p class="cta-title">{t.contact.subtitle}</p>
        <div class="cta-links">
          <a href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a>
          {[...socials, ...writing].map((s) => <a href={s.href}>{s.label}</a>)}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 4vw, 64px);
    align-items: center; padding-top: clamp(32px, 6vw, 72px); padding-bottom: clamp(40px, 6vw, 80px);
  }
  .name { font-size: clamp(72px, 13vw, 184px); margin: .3em 0 20px; }
  .arc { display: flex; gap: 12px; align-items: center; font-size: clamp(18px, 2.2vw, 24px); font-weight: 600; margin: 0 0 12px; }
  .arc-sep { color: var(--ink-soft); font-weight: 400; }
  .arc .now { color: var(--accent); }
  .tagline { font-size: clamp(18px, 2vw, 22px); max-width: 30ch; margin: 0 0 32px; color: var(--ink-soft); }
  .btn {
    display: inline-flex; gap: 14px; align-items: center; background: var(--accent); color: var(--accent-ink);
    padding: 16px 28px; text-decoration: none; font-weight: 500; transition: transform .15s;
  }
  .btn:hover { transform: translateX(4px); }
  .hero-actions { display: flex; gap: 12px; align-items: stretch; flex-wrap: wrap; }
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center; width: 56px; min-height: 56px;
    border: 1px solid var(--ink); color: var(--ink); transition: background .15s, color .15s;
  }
  .icon-btn svg { width: 22px; height: 22px; }
  .icon-btn:hover { background: var(--ink); color: var(--bg); }
  .loc { margin-top: 40px; }
  .hero-photo { position: relative; }
  .photo-frame { aspect-ratio: 4 / 5; overflow: hidden; background: var(--bg-alt); }
  .photo-frame img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%;
    filter: grayscale(1) contrast(1.15) brightness(.97);
  }
  .slash {
    position: absolute; right: -14px; bottom: 12%; width: 22px; height: 46%;
    background: var(--accent); transform: skewX(-18deg);
  }
  .dot {
    position: absolute; right: -36px; bottom: -18px; width: 64px; height: 64px;
    border-radius: 50%; background: var(--accent);
  }

  /* Areas strip */
  .strip { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .strip-inner {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding-top: 18px; padding-bottom: 18px; color: var(--ink); overflow-x: auto;
  }
  .strip-inner span { white-space: nowrap; }
  .dot-sm { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex: none; }

  /* Stats */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding-top: 56px; padding-bottom: 56px; }
  .stat { display: flex; flex-direction: column; gap: 8px; border-left: 1px solid var(--line); padding-left: 18px; }
  .stat-value { font-size: clamp(44px, 5vw, 64px); }

  /* Work */
  .work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .work-card { text-decoration: none; display: flex; flex-direction: column; gap: 14px; }
  .cover {
    aspect-ratio: 16 / 9; padding: 22px; display: flex; flex-direction: column; justify-content: space-between;
    transition: transform .2s;
  }
  .work-card:hover .cover { transform: translateY(-4px); }
  .cover-0 { background: var(--ink); color: #fff; }
  .cover-1 { background: var(--accent); color: var(--accent-ink); }
  .cover-2 { background: var(--bg-alt); color: var(--ink); border: 1px solid var(--line); }
  .cover-tag { color: inherit; opacity: .8; }
  .cover-metric { font-size: clamp(36px, 4vw, 54px); }
  .work-meta { display: flex; justify-content: space-between; gap: 12px; align-items: start; }
  .work-meta h3 { margin: 0 0 4px; font-size: 20px; line-height: 1.25; }
  .work-meta .label { margin: 0; }
  .arrow { font-size: 22px; transition: transform .15s; }
  .work-card:hover .arrow { transform: translateX(4px); color: var(--accent); }
  .work-summary { margin: 0; color: var(--ink-soft); font-size: 15px; }

  /* Experience */
  .xp { list-style: none; margin: 0; padding: 0; }
  .xp-item {
    display: grid; grid-template-columns: 80px 1fr 1.6fr; gap: 24px;
    padding: 32px 0; border-top: 1px solid var(--line);
  }
  .xp-num { font-size: 40px; color: var(--accent); }
  .xp-head h3 { margin: 0; font-size: 22px; }
  .xp-company { margin: 2px 0 6px; font-weight: 500; }
  .xp-highlights { margin: 0; padding-left: 18px; color: var(--ink-soft); font-size: 15px; }
  .xp-highlights li + li { margin-top: 8px; }

  /* Education */
  .edu { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; }
  .edu-item { padding: 24px 0; border-top: 1px solid var(--line); }
  .edu-item h3 { margin: 0; font-size: 20px; }
  .edu-item .xp-highlights { margin-top: 10px; }
  .edu-side { border-top: 1px solid var(--line); padding-top: 24px; }
  .edu-side > .label { margin: 0 0 12px; }
  .certs { list-style: none; margin: 0 0 32px; padding: 0; }
  .certs li { display: flex; flex-direction: column; gap: 2px; padding: 12px 0 12px 16px; border-left: 3px solid var(--accent); }
  .certs li + li { margin-top: 10px; }
  .cert-code { font-size: 13px; color: var(--ink-soft); }
  .cert-code code { font-size: 12px; background: var(--bg-alt); padding: 1px 6px; }
  .langs { list-style: none; margin: 0; padding: 0; }
  .langs li { display: grid; grid-template-columns: 28px 1fr auto; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .flag { width: 24px; height: auto; box-shadow: 0 0 0 1px var(--line); }
  .case-link {
    display: inline-block; margin-left: 6px; font-size: 13px; font-weight: 500; color: var(--accent);
    text-decoration: none; border-bottom: 1px solid currentColor; white-space: nowrap;
  }
  .case-link:hover { color: var(--ink); }
  .xp-highlights li.linked { color: var(--ink); }
  .xp-highlights li.linked::marker { color: var(--accent); }

  /* Skills */
  .skill-row { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding: 18px 0; border-top: 1px solid var(--line); }
  .skill-row .label { margin: 6px 0 0; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid var(--ink); padding: 4px 12px; font-size: 14px; border-radius: 999px; }

  /* Open source */
  .oss-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
